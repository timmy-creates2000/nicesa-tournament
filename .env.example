# --- API Server ---
# Port for the Hono backend (default 3001)
API_PORT=3001

# Secret used to sign admin JWTs — make this long and random
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-48-chars

# --- Frontend (Vite — VITE_ prefix required) ---
# URL of the Hono API server (use /api in production with a reverse proxy)
VITE_API_URL=http://localhost:3001
