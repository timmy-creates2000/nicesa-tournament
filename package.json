{
  "name": "nicesa-tournament",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --import ./server/load-env.js server/index.js",
    "build": "vite build",
    "start": "node --import ./server/load-env.js server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "bcryptjs": "2.4.3",
    "concurrently": "8.2.2",
    "date-fns": "3.6.0",
    "hono": "4.13.16",
    "jose": "5.10.0",
    "lucide-react": "0.468.0",
    "nanoid": "5.0.9",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "3.8.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11"
  }
}
